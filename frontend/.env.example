# Copie este arquivo para .env e ajuste os valores para o seu ambiente.

# Define se o frontend usa dados simulados (true) ou a API real (false).
# Use false para conectar ao backend real rodando em VITE_API_BASE_URL.
VITE_USE_MOCK=false

# URL base da API. Padrão: http://localhost:8000
# VITE_API_BASE_URL=http://localhost:8000
